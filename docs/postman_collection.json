    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks?projectId=proj-1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks"],
              "query": [{ "key": "projectId", "value": "proj-1" }]
            }
          }
        },
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Write OpenAPI Specification\",\n  \"description\": \"Document all endpoints and Zod validation schemas\",\n  \"status\": \"todo\",\n  \"priority\": \"high\",\n  \"projectId\": \"proj-1\",\n  \"assigneeId\": \"usr-1\",\n  \"dueDate\": \"2026-09-12\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks"]
            }
          }
        },
        {
          "name": "Update Task Status (todo / in-progress / done)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in-progress\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/tsk-2/status",
              "host": ["{{baseUrl}}"],
