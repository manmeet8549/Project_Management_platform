          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cloud Native Infrastructure Migration\",\n  \"description\": \"Migrating microservices to Kubernetes clusters\",\n  \"category\": \"DevOps\",\n  \"status\": \"planning\",\n  \"dueDate\": \"2026-11-15\"\n}"
